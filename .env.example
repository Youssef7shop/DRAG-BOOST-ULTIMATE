# ⚠️  DRAG BOOST — environment configuration
# Copy this file to .env and fill in your own values.
# NEVER commit real secrets to version control.

# ===== Application =====
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_NAME="DRAG BOOST"

# ===== Supabase (required) =====
# Public (anon) key — safe to expose in the browser
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
# Service-role key — SERVER SIDE ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Supabase Auth
SUPABASE_JWT_SECRET=your_jwt_secret

# ===== Authentication =====
# Session cookie names
SESSION_COOKIE_NAME=sb_session
CSRF_COOKIE_NAME=csrf_token

# Google OAuth (configure in Google Cloud Console + Supabase Auth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# ===== Rate limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ===== Payments =====
# Stripe (example provider — enable ONLY after credentials are verified)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ===== Providers (fulfillment adapters) =====
# Example provider credentials — leave blank unless a real provider is contracted
PROVIDER_API_KEY=your_provider_api_key
PROVIDER_API_SECRET=your_provider_api_secret
PROVIDER_BASE_URL=https://api.your-provider.example.com

# ===== Logging =====
LOG_LEVEL=info

# ===== Security =====
# CSRF protection (required when using cookie-based auth)
CSRF_ENABLED=true
# Cookie security (must be true behind HTTPS in production)
COOKIE_SECURE=false
# SameSite: lax | strict | none
COOKIE_SAME_SITE=Lax