{
  "name": "drag-boost",
  "version": "2.0.0",
  "description": "DRAG BOOST — premium digital-services marketplace. Node.js/Express backend, Supabase PostgreSQL + Auth, vanilla JS frontend.",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "lint": "eslint server public tests || true",
    "migrations:status": "echo 'Apply migrations via Supabase CLI or the Supabase SQL editor: supabase/migrations/*.sql'",
    "db:seed": "echo 'Run supabase/seed.sql in the Supabase SQL editor'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "p-limit": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "vitest": "^1.2.0",
    "supertest": "^6.3.3",
    "playwright": "^1.40.0"
  }
}